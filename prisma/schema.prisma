// PeoplePay360 - Prisma Schema
// Full HR & Payroll Platform

generator client {
  provider = "prisma-client-js"
}

generator server_client {
  provider = "prisma-client-js"
  output   = "../server/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  EMPLOYEE
  HR_MANAGER
  HR_PAYROLL_USER
  HR_PAYROLL_MANAGER
  ADMIN
}

enum EmployeeType {
  FULL_TIME
  PART_TIME
  CONTRACT
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  OVERTIME
  MISSING_CHECKOUT
  MANUAL_CORRECTION
  OUTSIDE_GEOFENCE
}

enum OvertimeStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TimeOffUnit {
  DAYS
  HOURS
}

enum TimeOffRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AllocationStatus {
  PENDING
  APPROVED
  REFUSED
  EXPIRED
}

enum SalaryRuleCategory {
  BASIC
  ALLOWANCE
  GROSS
  DEDUCTION
  NET
}

enum SalaryRuleComputationType {
  FIXED
  PERCENTAGE
  FORMULA
}

enum PayrunStatus {
  DRAFT
  COMPUTED
  VALIDATED
  PAID
  CANCELLED
}

enum PayslipStatus {
  DRAFT
  COMPUTED
  VALIDATED
  PAID
}

enum ScheduleType {
  FIXED
  FLEXIBLE
  SHIFT
}

enum HolidaySource {
  API_CALENDARIFIC
  API_NAGER
  MANUAL
}

enum HolidaySuggestionStatus {
  PENDING
  APPROVED_PAID
  APPROVED_UNPAID
  REJECTED
}

// ============================================================
// USER
// ============================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(EMPLOYEE)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee         Employee?
  createdLocations AttendanceLocation[] @relation("LocationCreatedBy")

  @@index([email])
}

// ============================================================
// ATTENDANCE LOCATION (GEOFENCING)
// ============================================================

model AttendanceLocation {
  id           String   @id @default(cuid())
  name         String   @unique
  latitude     Float
  longitude    Float
  radiusMeters Float    @default(500)
  isActive     Boolean  @default(true)
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdBy   User?        @relation("LocationCreatedBy", fields: [createdById], references: [id])
  employees   Employee[]
  attendances Attendance[]

  @@index([isActive])
}

model AttendanceLocationAudit {
  id            String   @id @default(cuid())
  locationId    String
  locationName  String
  changedById   String
  changedByName String?
  changeType    String // "CREATE", "UPDATE", "STATUS_TOGGLE", "DELETE", "ASSIGN"
  oldValues     Json?
  newValues     Json?
  createdAt     DateTime @default(now())

  @@index([locationId])
  @@index([createdAt])
}

// ============================================================
// DEPARTMENT
// ============================================================

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees Employee[]
  contracts Contract[]
}

// ============================================================
// WORKING SCHEDULE
// ============================================================

model WorkingSchedule {
  id                         String       @id @default(cuid())
  name                       String
  type                       ScheduleType @default(FIXED)
  weeklyHours                Float        @default(0)
  overtimeMultiplier         Float        @default(1.5)
  weekendOvertimeMultiplier  Float        @default(2.0)
  holidayOvertimeMultiplier  Float        @default(2.0)
  overtimeRequiresApproval   Boolean      @default(true)
  isActive                   Boolean      @default(true)
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  days      WorkingScheduleDay[]
  employees Employee[]
}

model WorkingScheduleDay {
  id           String  @id @default(cuid())
  scheduleId   String
  dayOfWeek    Int // 0=Sun, 1=Mon, ..., 6=Sat
  startTime    String // "09:00"
  endTime      String // "18:00"
  breakMinutes Int     @default(60)
  isWorkday    Boolean @default(true)

  schedule WorkingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
}

// ============================================================
// EMPLOYEE
// ============================================================

model Employee {
  id                   String         @id @default(cuid())
  employeeCode         String         @unique
  firstName            String
  lastName             String
  email                String         @unique
  phone                String?
  dateOfBirth          DateTime?
  joiningDate          DateTime
  departmentId         String?
  managerId            String?
  jobPosition          String?
  employeeType         EmployeeType   @default(FULL_TIME)
  status               EmployeeStatus @default(ACTIVE)
  userId               String?        @unique
  workingScheduleId    String?
  attendanceLocationId String?
  bankAccountName      String?
  bankAccountNumber    String?
  bankName             String?
  panNumber            String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  // Relations
  department         Department?         @relation(fields: [departmentId], references: [id])
  manager            Employee?           @relation("ManagerToEmployee", fields: [managerId], references: [id])
  subordinates       Employee[]          @relation("ManagerToEmployee")
  user               User?               @relation(fields: [userId], references: [id])
  workingSchedule    WorkingSchedule?    @relation(fields: [workingScheduleId], references: [id])
  attendanceLocation AttendanceLocation? @relation(fields: [attendanceLocationId], references: [id])

  contracts          Contract[]
  attendance         Attendance[]
  overtimes          Overtime[]
  timeOffRequests    TimeOffRequest[]
  timeOffAllocations TimeOffAllocation[]
  payslips           Payslip[]
  createdPayruns     Payrun[]            @relation("PayrunCreatedBy")

  @@index([departmentId])
  @@index([status])
  @@index([employeeType])
  @@index([workingScheduleId])
  @@index([attendanceLocationId])
}

// ============================================================
// CONTRACT
// ============================================================

model Contract {
  id                String         @id @default(cuid())
  employeeId        String
  startDate         DateTime
  endDate           DateTime?
  departmentId      String?
  position          String?
  wage              Float
  salaryStructureId String?
  annualLeaveQuota  Int            @default(24)
  status            ContractStatus @default(DRAFT)
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  department      Department?      @relation(fields: [departmentId], references: [id])
  salaryStructure SalaryStructure? @relation(fields: [salaryStructureId], references: [id])
  payslips        Payslip[]

  @@index([employeeId])
  @@index([startDate])
  @@index([endDate])
  @@index([status])
}

// ============================================================
// ATTENDANCE
// ============================================================

model Attendance {
  id                          String             @id @default(cuid())
  employeeId                  String
  date                        DateTime           @db.Date
  checkIn                     DateTime?
  checkOut                    DateTime?
  workedHours                 Float?
  status                      AttendanceStatus   @default(PRESENT)
  isManualCorrection          Boolean            @default(false)
  correctedById               String?
  correctedByName             String?
  correctionReason            String?
  correctedAt                 DateTime?
  notes                       String?
  checkInLatitude             Float?
  checkInLongitude            Float?
  checkInAccuracy             Float?
  checkOutLatitude            Float?
  checkOutLongitude           Float?
  checkOutAccuracy            Float?
  checkInDistanceMeters       Float?
  checkOutDistanceMeters      Float?
  checkInAllowedRadiusMeters  Float?
  checkOutAllowedRadiusMeters Float?
  attendanceLocationId        String?
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt

  employee           Employee            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  attendanceLocation AttendanceLocation? @relation(fields: [attendanceLocationId], references: [id])
  overtime           Overtime?

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([status])
  @@index([attendanceLocationId])
}

// ============================================================
// TIME OFF TYPE
// ============================================================

model TimeOffType {
  id                 String      @id @default(cuid())
  name               String
  unit               TimeOffUnit @default(DAYS)
  requiresAllocation Boolean     @default(true)
  requiresApproval   Boolean     @default(true)
  payrollIntegration Boolean     @default(false)
  description        String?
  isActive           Boolean     @default(true)
  color              String?     @default("#6366f1")
  isPaid             Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  allocations TimeOffAllocation[]
  requests    TimeOffRequest[]
}

// ============================================================
// TIME OFF ALLOCATION
// ============================================================

model TimeOffAllocation {
  id              String           @id @default(cuid())
  employeeId      String
  timeOffTypeId   String
  allocatedAmount Float
  takenAmount     Float            @default(0)
  remainingAmount Float
  validFrom       DateTime
  validTo         DateTime
  status          AllocationStatus @default(PENDING)
  approvedById    String?
  approvedByName  String?
  approvedAt      DateTime?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  timeOffType TimeOffType @relation(fields: [timeOffTypeId], references: [id])

  @@index([employeeId])
  @@index([timeOffTypeId])
  @@index([status])
}

// ============================================================
// TIME OFF REQUEST
// ============================================================

model TimeOffRequest {
  id              String               @id @default(cuid())
  employeeId      String
  timeOffTypeId   String
  startDate       DateTime             @db.Date
  endDate         DateTime             @db.Date
  duration        Float
  reason          String?
  status          TimeOffRequestStatus @default(PENDING)
  approvedById    String?
  approvedByName  String?
  approvedAt      DateTime?
  rejectedById    String?
  rejectedByName  String?
  rejectedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  timeOffType TimeOffType @relation(fields: [timeOffTypeId], references: [id])

  @@index([employeeId])
  @@index([timeOffTypeId])
  @@index([status])
}

// ============================================================
// SALARY STRUCTURE
// ============================================================

model SalaryStructure {
  id          String   @id @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rules     SalaryRule[]
  contracts Contract[]
  payruns   Payrun[]
  payslips  Payslip[]
}

// ============================================================
// SALARY RULE
// ============================================================

model SalaryRule {
  id                String                    @id @default(cuid())
  salaryStructureId String
  name              String
  code              String
  category          SalaryRuleCategory
  sequence          Int
  computationType   SalaryRuleComputationType @default(FIXED)
  fixedAmount       Float?
  percentage        Float?
  percentageBase    String? // code of the rule to base the % on
  formula           String? // safe formula string e.g. "GROSS - PF - TAX"
  description       String?
  isActive          Boolean                   @default(true)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  salaryStructure SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Restrict)
  payslipLines    PayslipLine[]

  @@unique([salaryStructureId, code])
  @@index([salaryStructureId])
  @@index([sequence])
}

// ============================================================
// PAYRUN
// ============================================================

model Payrun {
  id                String       @id @default(cuid())
  name              String
  periodStart       DateTime     @db.Date
  periodEnd         DateTime     @db.Date
  salaryStructureId String
  status            PayrunStatus @default(DRAFT)
  totalGross        Float        @default(0)
  totalDeductions   Float        @default(0)
  totalNet          Float        @default(0)
  createdById       String?
  notes             String?
  computedAt        DateTime?
  validatedAt       DateTime?
  finalizedAt       DateTime?
  paidAt            DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  salaryStructure SalaryStructure @relation(fields: [salaryStructureId], references: [id])
  createdBy       Employee?       @relation("PayrunCreatedBy", fields: [createdById], references: [id])
  payslips        Payslip[]

  @@index([periodStart])
  @@index([periodEnd])
  @@index([status])
}

// ============================================================
// PAYSLIP
// ============================================================

model Payslip {
  id                String        @id @default(cuid())
  payrunId          String
  employeeId        String
  contractId        String?
  salaryStructureId String?
  periodStart       DateTime      @db.Date
  periodEnd         DateTime      @db.Date
  workedDays        Float         @default(0)
  totalWorkingDays  Float         @default(0)
  leaveDays         Float         @default(0)
  overtimeHours     Float         @default(0)
  overtimeRate      Float         @default(0)
  overtimeAmount    Float         @default(0)
  status            PayslipStatus @default(DRAFT)
  grossSalary       Float         @default(0)
  totalDeductions   Float         @default(0)
  netSalary         Float         @default(0)
  hasWarnings       Boolean       @default(false)
  hasErrors         Boolean       @default(false)
  validationNotes   Json?
  emailSent         Boolean       @default(false)
  emailSentAt       DateTime?
  emailError        String?
  effectivePeriodStart DateTime?  @db.Date
  effectivePeriodEnd   DateTime?  @db.Date
  isOverride           Boolean    @default(false)
  overrideWarning      String?
  overrideBy           String?
  overrideAt           DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  payrun          Payrun           @relation(fields: [payrunId], references: [id], onDelete: Restrict)
  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  contract        Contract?        @relation(fields: [contractId], references: [id])
  salaryStructure SalaryStructure? @relation(fields: [salaryStructureId], references: [id])
  lines           PayslipLine[]

  @@unique([employeeId, payrunId])
  @@index([payrunId])
  @@index([employeeId])
  @@index([status])
  @@index([periodStart])
  @@index([periodEnd])
}

// ============================================================
// OVERTIME
// ============================================================

model Overtime {
  id                 String         @id @default(cuid())
  employeeId         String
  attendanceId       String?        @unique
  date               DateTime       @db.Date
  expectedHours      Float          @default(8)
  actualHours        Float          @default(0)
  overtimeHours      Float          @default(0)
  hourlyRate         Float          @default(0)
  multiplier         Float          @default(1.5)
  overtimeRate       Float          @default(0)
  overtimeAmount     Float          @default(0)
  status             OvertimeStatus @default(PENDING)
  reason             String?

  // Approval audit
  approvedById       String?
  approvedByName     String?
  approvedAt         DateTime?
  rejectedById       String?
  rejectedByName     String?
  rejectedAt         DateTime?
  rejectionReason    String?

  // Correction audit
  isManualCorrection Boolean        @default(false)
  correctedById      String?
  correctedByName    String?
  correctionReason   String?
  correctedAt        DateTime?
  originalHours      Float?

  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  employee           Employee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  attendance         Attendance?    @relation(fields: [attendanceId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([date])
  @@index([status])
}

// ============================================================
// PAYSLIP LINE
// ============================================================

model PayslipLine {
  id           String             @id @default(cuid())
  payslipId    String
  salaryRuleId String?
  name         String
  code         String
  category     SalaryRuleCategory
  sequence     Int
  amount       Float
  quantity     Float              @default(1)
  rate         Float?
  createdAt    DateTime           @default(now())

  payslip    Payslip     @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  salaryRule SalaryRule? @relation(fields: [salaryRuleId], references: [id])

  @@index([payslipId])
  @@index([sequence])
}

// ============================================================
// WORKING DAYS POLICY
// ============================================================

model WorkingDaysPolicy {
  id              String   @id @default(cuid())
  name            String   @default("Standard Monthly Policy")
  totalDays       Int      @default(22)
  effectivePeriod String?  // e.g. "2026-09" or null for default global policy
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([effectivePeriod])
}

// ============================================================
// HOLIDAY SUGGESTION & COMPANY HOLIDAYS
// ============================================================

model HolidaySuggestion {
  id        String                  @id @default(cuid())
  date      DateTime                @db.Date
  name      String
  source    HolidaySource           @default(API_CALENDARIFIC)
  status    HolidaySuggestionStatus @default(PENDING)
  country   String                  @default("IN")
  state     String?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  companyHoliday CompanyHoliday?

  @@unique([date, name])
  @@index([date])
  @@index([status])
}

// ============================================================
// COMPANY HOLIDAY
// ============================================================

model CompanyHoliday {
  id                 String   @id @default(cuid())
  date               DateTime @db.Date
  name               String
  isPaid             Boolean  @default(true)
  linkedSuggestionId String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  linkedSuggestion HolidaySuggestion? @relation(fields: [linkedSuggestionId], references: [id])

  @@index([date])
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id          String   @id @default(cuid())
  actionType  String   // e.g. "PAYRUN_CREATE", "STRUCTURE_UPDATE", "RULE_UPDATE", "EMPLOYEE_STATUS", "CONTRACT_END"
  entityType  String   // "PAYRUN", "SALARY_STRUCTURE", "SALARY_RULE", "EMPLOYEE", "CONTRACT", "USER"
  entityId    String?
  description String
  performedBy String   // User email / name
  createdAt   DateTime @default(now())

  @@index([createdAt])
}


